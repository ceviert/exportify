# Exportify configuration template.
# Copy this file to `.env` and fill in your own Spotify credentials.
# Get them from the Spotify Developer Dashboard: https://developer.spotify.com/dashboard/

SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"

# Paths default to sensible locations inside the container (/app); override only if needed.
CACHE_PATH="data/songcache.json"
# DOWNLOAD_DIR="downloads"
# COOKIE_PATH="data/cookies.txt"
# SPOTIPY_CACHE="data/.spotipy_cache"
