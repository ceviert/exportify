# Exportify configuration template.
# Copy this file to `.env` to customize paths.
#
# Spotify access is automatic by default: Exportify tries the anonymous
# web-player token first (no credentials needed). On networks that block that
# endpoint, uncomment the two credential lines and Exportify will fall back to
# them automatically. You can also force one path with SPOTIFY_AUTH.

# SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
# SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
# SPOTIFY_AUTH="auto"   # auto (anonymous, then credentials) | anonymous | credentials

# Paths default to sensible locations inside the container (/app); override only if needed.
CACHE_PATH="data/songcache.json"
# DOWNLOAD_DIR="downloads"
# COOKIE_PATH="data/cookies.txt"
# SPOTIFY_TOKEN_CACHE="data/.spotify_token.json"
# SPOTIPY_CACHE="data/.spotipy_cache"
